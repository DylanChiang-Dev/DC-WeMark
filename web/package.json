{
  "name": "dc-wemark-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build:wasm": "npm run build:wasm:core && npm run build:wasm:highlight",
    "build:wasm:core": "wasm-pack build ../crates/wemark-core --target web --release --out-dir ../../web/src/wasm",
    "build:wasm:highlight": "wasm-pack build ../crates/wemark-core --target web --release --out-dir ../../web/src/wasm-highlight --out-name wemark_highlight -- --features syntax-highlight",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
